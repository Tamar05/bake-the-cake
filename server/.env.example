SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001

# Email (Resend) — used to notify a baker when they commit to bake a cake.
# Optional: if RESEND_API_KEY is unset, the app simply skips sending.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address. The default sandbox sender (onboarding@resend.dev) can only
# deliver to your own Resend account email until you verify a domain; once you
# have a verified domain, set e.g. EMAIL_FROM="Bake the Cake <cakes@yourdomain.org>".
EMAIL_FROM=
