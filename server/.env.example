# The Supabase project. SUPABASE_SERVICE_ROLE_KEY is the SECRET key — server-only,
# never in the browser or committed to git. Both are required.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The port to listen on. Locally defaults to 3001; hosts like Render set this
# automatically, so leave it unset in production.
PORT=3001

# Production only: comma-separated list of the frontend origin(s) allowed to call
# this API, e.g. https://bake-the-cake.pages.dev. Unset in local dev = allow any.
CORS_ORIGIN=
