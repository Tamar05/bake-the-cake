# The backend API base URL. Local dev: http://localhost:3001. In production
# (Cloudflare Pages), set this to your Render backend URL, e.g.
# https://bake-the-cake-server.onrender.com
VITE_API_BASE_URL=http://localhost:3001
# Supabase project URL and the PUBLISHABLE (anon) key — safe for the browser.
# Never put the secret key here; that stays in server/.env only.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Web push: the VAPID PUBLIC key (base64url) — safe for the browser. The matching
# private key stays in server/.env only. Generate a pair with `npx web-push generate-vapid-keys`.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
